{
  "name": "gmsim",
  "version": "0.186.0",
  "private": true,
  "description": "Authentic NFL GM simulator — single-player, 32-team Living League",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:monitor": "pnpm --filter @gmsim/engine test:monitor",
    "test:timed": "pnpm --filter @gmsim/engine exec vitest run --reporter=default --reporter=json --outputFile=vitest-report.json && node scripts/test-timing-audit.mjs packages/engine/vitest-report.json",
    "timing:audit": "node scripts/test-timing-audit.mjs packages/engine/vitest-report*.json",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "version:check": "node scripts/sync-versions.mjs",
    "version:sync": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
